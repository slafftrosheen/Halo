<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="halo.db" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="halo_appearance.xml" />
        <exclude domain="file" path="workspace/owned/" />
        <exclude domain="file" path="workspace/artifacts/" />
        <exclude domain="file" path="captures/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="halo.db" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="halo_appearance.xml" />
        <exclude domain="file" path="captures/" />
    </device-transfer>
</data-extraction-rules>
