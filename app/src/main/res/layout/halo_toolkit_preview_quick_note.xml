<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/halo_everyday_widget_background" android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp"
            android:src="@drawable/halo_ic_notebook" android:tint="@color/everyday_widget_metadata" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="@font/sora_variable" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.045"
            android:includeFontPadding="false" android:textAllCaps="true" android:maxLines="1" android:ellipsize="end"
            android:textColor="@color/everyday_widget_metadata" android:text="@string/widget_toolkit_quick_note" />
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="4dp"
            android:src="@drawable/ic_halo_widget_ask" android:importantForAccessibility="no" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:fontFamily="@font/sora_variable" android:textSize="16sp"
        android:includeFontPadding="false" android:textStyle="bold" android:letterSpacing="-0.025"
        android:maxLines="1" android:ellipsize="end"
        android:textColor="@color/everyday_widget_text" android:text="@string/widget_toolkit_quick_note_preview" />


</LinearLayout>
