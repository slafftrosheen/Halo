<?xml version="1.0" encoding="utf-8"?>
<!-- halo Zone 6 widget face. Drop-in: keeps every Zone 5 view id used by EverydayWidgetViews.kt; new ids are optional (gone by default). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/halo_everyday_widget_background">
<ImageView android:id="@+id/everyday_widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="14dp">
<!-- Header: small label + "ask halo about this" ring (48dp target) -->
<LinearLayout android:id="@+id/everyday_widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:id="@+id/everyday_widget_orb" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="8dp" android:src="@drawable/halo_ic_timer" android:tint="@color/everyday_widget_metadata" android:importantForAccessibility="no" />
<TextView android:id="@+id/everyday_widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textStyle="bold" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:text="@string/everyday_widget_alarms_timers" android:textColor="@color/everyday_widget_metadata" />
<ImageView android:layout_width="15dp" android:layout_height="15dp" android:layout_marginEnd="4dp"
    android:src="@drawable/ic_halo_widget_ask" android:importantForAccessibility="no" />
<FrameLayout android:id="@+id/everyday_widget_ask" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" android:contentDescription="@string/everyday_widget_ask">
<ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:background="@drawable/halo_widget_ask_disc" android:padding="8dp" android:src="@drawable/ic_halo_widget_ask" android:importantForAccessibility="no" />
</FrameLayout>
</LinearLayout>
<!-- Official alert (Apricot) — only for ALERTS/WARNING rows, top of Your day -->
<TextView android:id="@+id/everyday_widget_alert" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="36dp" android:layout_marginBottom="8dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="14dp" android:background="@drawable/halo_widget_pill_attention" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/everyday_widget_attention_ink" android:maxLines="2" android:visibility="gone" />
<TextView android:id="@+id/everyday_widget_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/sora_variable" android:textSize="22sp" android:letterSpacing="-0.01" android:text="@string/everyday_widget_preview" android:textColor="@color/everyday_widget_text" android:layout_marginBottom="6dp" android:layout_marginEnd="8dp" />
<TextClock android:id="@+id/everyday_widget_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/sora_variable" android:textSize="40sp" android:letterSpacing="-0.04" android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:visibility="gone" android:textColor="@color/everyday_widget_text" android:layout_marginBottom="2dp" />
<TextClock android:id="@+id/everyday_widget_clock_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="16sp" android:textColor="@color/everyday_widget_metadata" android:format12Hour="yyyy-MM-dd" android:format24Hour="yyyy-MM-dd" android:visibility="gone" />
<TextView android:id="@+id/everyday_widget_clock_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="16sp" android:textColor="@color/everyday_widget_metadata" android:visibility="gone" />
<TextView android:id="@+id/everyday_widget_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:minHeight="48dp" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/halo_widget_row_divider" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="16sp" android:lineSpacingMultiplier="1.15" android:textColor="@color/everyday_widget_text" android:visibility="gone" />
<TextView android:id="@+id/everyday_widget_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:minHeight="48dp" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/halo_widget_row_divider" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="16sp" android:lineSpacingMultiplier="1.15" android:textColor="@color/everyday_widget_text" android:visibility="gone" />
<TextView android:id="@+id/everyday_widget_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:minHeight="48dp" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/halo_widget_row_divider" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="16sp" android:lineSpacingMultiplier="1.15" android:textColor="@color/everyday_widget_text" android:visibility="gone" />
<!-- Freshness line: "Updated 9:38 · from 6 sources" / amber "Updated 2 h ago · can't reach the source" -->
<TextView android:id="@+id/everyday_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginEnd="8dp" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="13sp" android:text="@string/everyday_widget_saved" android:textColor="@color/everyday_widget_metadata" android:maxLines="2" />
<!-- One fix: "Choose a source" / "Try again" — pill, 48dp target -->
<TextView android:id="@+id/everyday_widget_configure" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/halo_widget_pill" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textStyle="bold" android:textSize="15sp" android:text="@string/everyday_widget_configure" android:textColor="@color/everyday_widget_primary" android:visibility="gone" />
</LinearLayout></FrameLayout>
