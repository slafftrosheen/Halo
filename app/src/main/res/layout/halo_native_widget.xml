<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/halo_widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textSize="20sp" android:textColor="#F5F7F6" />
    <TextView android:id="@+id/halo_widget_talk" android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical" android:textSize="16sp" android:textColor="#7DE2B1" />
    <TextView android:id="@+id/halo_widget_notebook" android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical" android:textSize="16sp" android:textColor="#F5F7F6" />
</LinearLayout>
