<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/everyday_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/halo_everyday_widget_background">
<ImageView android:id="@+id/everyday_widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:id="@+id/everyday_widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:id="@+id/everyday_widget_orb" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_halo_brand_halo" android:importantForAccessibility="no" />
<TextView android:id="@+id/everyday_widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/sora_variable" android:textSize="18sp" android:text="@string/everyday_widget_dashboard" android:textColor="@color/everyday_widget_text" />
</LinearLayout>
<TextView android:id="@+id/everyday_widget_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/sora_variable" android:textSize="20sp" android:text="@string/everyday_widget_preview" android:textColor="@color/everyday_widget_text" android:layout_marginBottom="8dp" />
<TextClock android:id="@+id/everyday_widget_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/sora_variable" android:textSize="32sp" android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:visibility="gone" android:textColor="@color/everyday_widget_text" android:layout_marginBottom="8dp" />
<TextClock android:id="@+id/everyday_widget_clock_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="16sp" android:format12Hour="yyyy-MM-dd" android:format24Hour="yyyy-MM-dd" android:visibility="gone" />
<TextView android:id="@+id/everyday_widget_clock_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="16sp" android:visibility="gone" />
<TextView android:id="@+id/everyday_widget_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:minHeight="48dp" android:gravity="center_vertical" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="16sp" android:textColor="@color/everyday_widget_text" android:visibility="gone" />
<TextView android:id="@+id/everyday_widget_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:minHeight="48dp" android:gravity="center_vertical" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="16sp" android:textColor="@color/everyday_widget_text" android:visibility="gone" />
<TextView android:id="@+id/everyday_widget_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:minHeight="48dp" android:gravity="center_vertical" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="16sp" android:textColor="@color/everyday_widget_text" android:visibility="gone" />
<TextView android:id="@+id/everyday_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="14sp" android:text="@string/everyday_widget_saved" android:textColor="@color/everyday_widget_metadata" />
<TextView android:id="@+id/everyday_widget_configure" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="16sp" android:text="@string/everyday_widget_configure" android:textColor="@color/everyday_widget_primary" android:visibility="gone" />
</LinearLayout></FrameLayout>
