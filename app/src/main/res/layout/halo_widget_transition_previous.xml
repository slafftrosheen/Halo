<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp"
    android:importantForAccessibility="noHideDescendants"
    android:background="@drawable/halo_everyday_widget_background">
    <TextView android:id="@+id/widget_previous_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="1"
        android:ellipsize="end" android:fontFamily="@font/atkinson_hyperlegible_next_variable" />
    <TextView android:id="@+id/widget_previous_value" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="20sp" android:layout_marginTop="10dp"
        android:maxLines="2" android:ellipsize="end" android:fontFamily="@font/atkinson_hyperlegible_next_variable" />
</LinearLayout>
