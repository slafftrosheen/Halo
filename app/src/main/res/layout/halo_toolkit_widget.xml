<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/toolkit_widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/toolkit_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="top" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:id="@+id/toolkit_widget_header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/toolkit_widget_glyph" android:layout_width="14dp" android:layout_height="14dp"
                android:layout_marginEnd="6dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/toolkit_widget_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:fontFamily="@font/sora_variable" android:textSize="11sp" android:letterSpacing="0.045"
                android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1"
                android:ellipsize="end" android:textColor="@color/everyday_widget_metadata" />
            <ImageView android:id="@+id/toolkit_widget_orb" android:layout_width="16dp" android:layout_height="16dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_halo_brand_halo" />
        </LinearLayout>
        <LinearLayout android:id="@+id/toolkit_widget_week" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone">
            <TextView android:id="@+id/toolkit_widget_day1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:fontFamily="@font/sora_variable" android:textSize="12sp"
                android:maxLines="3" android:layout_marginHorizontal="2dp" android:paddingVertical="4dp" android:includeFontPadding="false" />
            <TextView android:id="@+id/toolkit_widget_day2" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:fontFamily="@font/sora_variable" android:textSize="12sp"
                android:maxLines="3" android:layout_marginHorizontal="2dp" android:paddingVertical="4dp" android:includeFontPadding="false" />
            <TextView android:id="@+id/toolkit_widget_day3" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:fontFamily="@font/sora_variable" android:textSize="12sp"
                android:maxLines="3" android:layout_marginHorizontal="2dp" android:paddingVertical="4dp" android:includeFontPadding="false" />
            <TextView android:id="@+id/toolkit_widget_day4" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:fontFamily="@font/sora_variable" android:textSize="12sp"
                android:maxLines="3" android:layout_marginHorizontal="2dp" android:paddingVertical="4dp" android:includeFontPadding="false" />
            <TextView android:id="@+id/toolkit_widget_day5" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:fontFamily="@font/sora_variable" android:textSize="12sp"
                android:maxLines="3" android:layout_marginHorizontal="2dp" android:paddingVertical="4dp" android:includeFontPadding="false" />
            <TextView android:id="@+id/toolkit_widget_day6" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:fontFamily="@font/sora_variable" android:textSize="12sp"
                android:maxLines="3" android:layout_marginHorizontal="2dp" android:paddingVertical="4dp" android:includeFontPadding="false" />
            <TextView android:id="@+id/toolkit_widget_day7" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:fontFamily="@font/sora_variable" android:textSize="12sp"
                android:maxLines="3" android:layout_marginHorizontal="2dp" android:paddingVertical="4dp" android:includeFontPadding="false" />
        </LinearLayout>
        <FrameLayout android:id="@+id/toolkit_widget_ring_panel" android:layout_width="80dp" android:layout_height="80dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:visibility="gone">
            <ImageView android:id="@+id/toolkit_widget_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/toolkit_widget_ring_label" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:maxLines="1" android:fontFamily="@font/sora_variable" android:textSize="15sp"
                android:includeFontPadding="false" />
            <Chronometer android:id="@+id/toolkit_widget_ring_clock" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center" android:maxLines="1" android:fontFamily="@font/sora_variable"
                android:textSize="15sp" android:includeFontPadding="false" android:visibility="gone" />
        </FrameLayout>
        <TextView android:id="@+id/toolkit_widget_value" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:fontFamily="@font/sora_variable" android:includeFontPadding="false"
            android:textSize="20sp" android:letterSpacing="-0.025" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:textColor="@color/everyday_widget_text" />
        <Chronometer android:id="@+id/toolkit_widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:fontFamily="@font/sora_variable" android:includeFontPadding="false" android:textSize="18sp"
            android:maxLines="1" android:visibility="gone" />
        <TextView android:id="@+id/toolkit_widget_marks" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:fontFamily="@font/atkinson_hyperlegible_next_variable"
            android:textSize="16sp" android:maxLines="3" android:visibility="gone" />
        <TextView android:id="@+id/toolkit_widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:fontFamily="@font/atkinson_hyperlegible_next_variable"
            android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
        <FrameLayout android:id="@+id/toolkit_widget_action" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:visibility="gone">
            <ImageView android:id="@+id/toolkit_widget_action_background" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingStart="9dp" android:paddingEnd="10dp" android:minHeight="30dp">
                <ImageView android:id="@+id/toolkit_widget_action_glyph" android:layout_width="13dp" android:layout_height="13dp"
                    android:layout_marginEnd="4dp" android:importantForAccessibility="no" />
                <TextView android:id="@+id/toolkit_widget_action_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textStyle="bold" android:textSize="13sp"
                    android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:id="@+id/toolkit_widget_status_row" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal"
            android:gravity="center_vertical">
            <ProgressBar android:id="@+id/toolkit_widget_fresh_signal" style="?android:attr/progressBarStyleSmall"
                android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="4dp"
                android:indeterminate="true" android:indeterminateDrawable="@drawable/halo_widget_fresh_signal"
                android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/toolkit_widget_status" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:fontFamily="@font/atkinson_hyperlegible_next_variable"
                android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false"
                android:textColor="@color/everyday_widget_metadata" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/toolkit_widget_dots" android:layout_width="14dp" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end" android:layout_marginEnd="5dp"
        android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="10sp"
        android:includeFontPadding="false" android:lineSpacingExtra="1dp" android:gravity="center"
        android:maxLines="5" android:visibility="gone" />
</FrameLayout>
