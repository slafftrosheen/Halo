<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/halo_everyday_widget_background" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp"
            android:src="@drawable/halo_ic_mic" android:tint="@color/everyday_widget_metadata" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="@font/sora_variable" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.045"
            android:includeFontPadding="false" android:textAllCaps="true" android:maxLines="1" android:ellipsize="end"
            android:textColor="@color/everyday_widget_metadata" android:text="@string/widget_toolkit_record" />
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="4dp"
            android:src="@drawable/ic_halo_widget_ask" android:importantForAccessibility="no" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:fontFamily="@font/sora_variable" android:textSize="19sp"
        android:includeFontPadding="false" android:textStyle="bold" android:letterSpacing="-0.025"
        android:maxLines="2" android:ellipsize="end"
        android:textColor="@color/everyday_widget_text" android:text="@string/widget_toolkit_preview_record_title" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="11sp" android:includeFontPadding="false"
        android:maxLines="1" android:ellipsize="end" android:textColor="@color/everyday_widget_metadata"
        android:text="@string/widget_toolkit_preview_record_detail" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="28dp"
        android:layout_marginTop="6dp" android:gravity="center" android:paddingHorizontal="9dp"
        android:fontFamily="@font/atkinson_hyperlegible_next_variable" android:textSize="12sp" android:textStyle="bold"
        android:background="@drawable/halo_widget_preview_action" android:textColor="@color/halo_widget_preview_action_text"
        android:text="@string/widget_toolkit_record_preview" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
