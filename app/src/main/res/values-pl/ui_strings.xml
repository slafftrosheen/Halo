    <string name="ui_b0aedda34eac" formatted="false">"Wybierz źródła, których halo może szukać, a następnie utwórz lokalny indeks."</string>
    <string name="ui_02126cf07a25" formatted="false">"Za mało wolnej pamięci roboczej. Zamknij inne modele lub wybierz mniej źródeł."</string>
