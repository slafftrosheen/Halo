    <string name="ui_7bc5279a8267" formatted="false">"Wyjaśnij ten obszar, korzystając z zapisanej referencji do źródła i dołączonego wycinka. Jeśli moje pytanie dotyczy innego obszaru albo jest niejednoznaczne, najpierw zapytaj, o który obszar chodzi. Jeśli samo zaznaczenie jest niejasne, poproś mnie o jego opis."</string>
    <string name="ui_0562eec23e31" formatted="false">"Użyj mojego zapisanego zaznaczenia odręcznego jako punktu odniesienia."</string>
    <string name="ui_a45d0de015bd" formatted="false">"Wyszukuj lokalnie na tym telefonie tekst, obrazy, nagrania i krótkie filmy z wybranych źródeł Notebooka, Canvas i Nauki. W przypadku filmów używane są tylko cztery wybrane klatki; ścieżki dźwiękowe nie są przetwarzane. halo odczytuje wyłącznie źródła zatwierdzone podczas tworzenia indeksu."</string>
    <string name="ui_587513a42667" formatted="false">"Wyszukiwanie obrazów wymaga zweryfikowanego modelu EmbeddingGemma 2. Odznacz obrazy, aby wyszukiwać lokalnie tylko w tekście."</string>
    <string name="ui_6c8f6c2d66fa" formatted="false">"Ten telefon nie może uruchomić kodera obrazów na procesorze CPU. Odznacz obrazy, aby kontynuować wyszukiwanie lokalne tylko w tekście."</string>
    <string name="ui_00add6a49156" formatted="false">"Ten format lub rozmiar obrazu nie jest obsługiwany w wyszukiwaniu lokalnym. Użyj pliku PNG lub JPEG o rozmiarze do 4 MiB."</string>
    <string name="ui_fffa5f83baf0" formatted="false">"Wybrany obraz jest niedostępny lub nie masz już do niego dostępu. Dołącz go ponownie albo usuń z wyszukiwania lokalnego."</string>
    <string name="ui_e86583f2b967" formatted="false">"Wyszukiwanie nagrań wymaga zweryfikowanego modelu EmbeddingGemma 2. Odznacz nagrania, aby wyszukiwać lokalnie tylko w tekście."</string>
    <string name="ui_c85c887657ab" formatted="false">"Ten telefon nie może uruchomić kodera dźwięku na procesorze CPU. Odznacz nagrania, aby kontynuować wyszukiwanie lokalne tylko w tekście."</string>
    <string name="ui_5bf1f3af4662" formatted="false">"To nagranie nie jest obsługiwane w wyszukiwaniu lokalnym. Użyj pliku audio o długości do dwóch minut i rozmiarze do 12 MB."</string>
    <string name="ui_36f112ede148" formatted="false">"Wybrane nagranie jest niedostępne lub nie masz już do niego dostępu. Dołącz je ponownie albo usuń z wyszukiwania lokalnego."</string>
