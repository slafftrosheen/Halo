{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "halo://adaptive/page-plan/1",
 "title": "halo page plan (12.0)",
 "type": "object",
 "required": [
  "page",
  "mode",
  "density",
  "blocks"
 ],
 "additionalProperties": false,
 "properties": {
  "page": {
   "type": "string",
   "pattern": "^[a-z0-9-]{1,60}$"
  },
  "title": {
   "type": "string",
   "maxLength": 40
  },
  "mode": {
   "enum": [
    "adult",
    "kids",
    "study",
    "kidsStudy"
   ]
  },
  "density": {
   "enum": [
    "easy",
    "standard",
    "pro"
   ]
  },
  "surface": {
   "enum": [
    "phone",
    "tablet",
    "glasses",
    "watch"
   ],
   "default": "phone"
  },
  "refresh": {
   "type": "string",
   "description": "cron-like or 'onOpen'; live blocks re-check data, never re-layout without the user"
  },
  "saveAs": {
   "enum": [
    "none",
    "page",
    "widget",
    "routine"
   ],
   "default": "none"
  },
  "blocks": {
   "type": "array",
   "minItems": 1,
   "maxItems": 9,
   "items": {
    "type": "object",
    "required": [
     "type"
    ],
    "additionalProperties": false,
    "properties": {
     "type": {
      "enum": [
       "text",
       "sourceCard",
       "gallery",
       "explainer",
       "checklist",
       "timer",
       "askFirstAction",
       "steps",
       "options",
       "compare",
       "rank",
       "question",
       "sketch",
       "note",
       "board",
       "image",
       "timeline",
       "table",
       "chart",
       "map",
       "ask",
       "thread",
       "listen",
       "device"
      ]
     },
     "span": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
     },
     "why": {
      "type": "string",
      "maxLength": 140
     },
     "source": {
      "type": "string",
      "maxLength": 80
     },
     "max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
     },
     "action": {
      "enum": [
       "pay",
       "send",
       "book",
       "post",
       "delete",
       "generate"
      ]
     },
     "limit": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "pinned": {
      "type": "boolean"
     },
     "data": {
      "type": "object",
      "description": "typed by block; validated by the block's own decoder"
     }
    }
   }
  }
 }
}