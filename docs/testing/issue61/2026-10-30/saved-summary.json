    {
      "id": "60399972-2b00-47f9-95c6-64ecd026f852",
      "noteId": "e90d4692-4430-44b0-8497-d0668d30acec",
      "position": 10,
      "type": "PARAGRAPH",
      "text": "[source] HALO-QA-20261029 EVAPORATION",
      "checked": 0,
      "indent": 0,
      "refObjectId": null,
      "language": null,
      "createdAtEpochMs": 1793358889628,
