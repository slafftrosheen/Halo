    {
      "id": "19e80f02-d13e-4728-b83f-c8659bd67a54",
      "noteId": "e90d4692-4430-44b0-8497-d0668d30acec",
      "position": 18,
      "type": "PARAGRAPH",
      "text": "[source] HALO-QA-20261029 EVAPORATION",
      "checked": 0,
      "indent": 0,
      "refObjectId": null,
      "language": null,
