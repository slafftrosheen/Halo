 "backRules": [
  "One back = one step",
  "Back never loses work (autosave)",
  "Back from a graph start goes Home",
  "Back on Home does nothing (no exit prompt)",
  "Dock tap pops to that graph start and restores its state; re-tap pops to start",
  "Deep links build a synthetic stack (Home › graph start › target)",
  "Confirm sheets, popups and setup are sheets/dialogs, never stack entries",
  "Kids graph is a separate root; leaving needs the family phone lock"
 ],
 "limits": {
  "maxTapsToTool": 2,
  "maxTapsToSetting": 3,
  "maxTapsViaSearch": 2,
  "maxTabRows": 1
 },
