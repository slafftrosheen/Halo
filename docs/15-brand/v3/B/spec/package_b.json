 "light_rules": [
  {
   "rule": "Aura",
   "text": "Soft light at the top of every screen in the accent colour. Breathes: idle 4.8 s, thinking 2.6 s, acting 2.4 s, listening 1.8 s. Apricot when halo needs you, faint red on error, one bloom on a confirmed result."
  },
  {
   "rule": "Edge light",
   "text": "The phone itself gets a halo, but only while halo is listening as your assistant or actually acting. One sweep up both sides on invoke, then a slow pulse. Apricot when it needs you. Never spins."
  },
  {
   "rule": "Live task pill",
   "text": "A running task hugs the nav on every tab: orb, short title, real progress, Stop. Tap opens the run. Turns Apricot when it needs you."
  },
  {
   "rule": "One step ahead",
   "text": "After an answer, up to 3 next actions appear above the composer and a ghost suggestion sits in the field. Nothing is sent until you tap. Never suggests cloud, payments, permissions or deleting."
  },
  {
   "rule": "Glass + depth",
   "text": "Nav, composer, sheets and the assistant card are frosted glass over the aura. No live blur below Android 12 or when the phone is hot: solid surfaces, same layout."
  },
  {
   "rule": "Real events only",
   "text": "Listening when the mic is open. Speaking when audio plays. Edge while acting. Bloom only on a CONFIRMED receipt. Stop collapses every light in 333 ms."
  }
 ],
