{
  "version": "voice-read-1.0 · DevKit v1.4 · BrandBook v2.3",
  "kinds": [
    {
      "id": "TEXT",
      "use": "Free text (notes, cards, replies, prompts, routines)",
      "behaviour": "Mic in the field. Speech becomes a PREVIEW chip: Use spoken text · Edit before using · Discard. Read aloud reads the draft.",
      "voice": "on",
      "read": "on"
    },
    {
      "id": "SEARCH",
      "use": "Search & filter",
      "behaviour": "Mic in the field. Spoken words go straight in and run the search (harmless, one-tap undo).",
      "voice": "on",
      "read": "results"
    },
    {
      "id": "SHORT",
      "use": "Names, titles, labels",
      "behaviour": "Mic in the field; single line; preview chip; auto-capitalised.",
      "voice": "on",
      "read": "on"
    },
    {
      "id": "NUMBER",
      "use": "Numbers, durations, page numbers",
      "behaviour": "Mic in the field; shows what was heard and the number it became: “twelve” → 12.",
      "voice": "on",
      "read": "on"
    },
    {
      "id": "CODE",
      "use": "Pairing / verification codes",
      "behaviour": "Mic in the field; digits spoken one by one, shown grouped; always confirmed before use.",
      "voice": "on",
      "read": "masked by default"
    },
    {
      "id": "URL_ID",
      "use": "URLs, server addresses, IDs",
      "behaviour": "No mic by default (speech is unreliable here). Paste, scan or pick; read aloud spells it out.",
      "voice": "off",
      "read": "spelled"
    },
    {
      "id": "SECRET",
      "use": "API keys, passwords, tokens",
      "behaviour": "No mic, no read aloud, never sent to speech. TalkBack says “hidden”. Lock glyph instead of mic.",
      "voice": "never",
      "read": "never"
    },
    {
      "id": "STRUCTURED",
      "use": "JSON / schema / code",
      "behaviour": "No dictation into raw syntax. Mic opens “Describe it” — halo drafts the structure, shown as a draft to review.",
      "voice": "describe",
      "read": "summary"
    }
  ],
