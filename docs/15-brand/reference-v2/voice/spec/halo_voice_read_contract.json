  "components": [
    {
      "id": "VR-FIELD",
      "name": "HaloTextField (voice field)",
      "purpose": "The ONE text field: label, value, kind, trailing mic (or lock for SECRET), read button when there's text. Replaces direct OutlinedTextField use. Built on HaloVoiceTextActions.",
      "status": "new (wraps existing)"
    },
    {
      "id": "VR-PREVIEW",
      "name": "Spoken-text preview",
      "purpose": "What was heard, as an uncommitted chip under the field: Use spoken text · Edit before using · Discard. Low-confidence words underlined.",
      "status": "existing → restyled"
    },
    {
      "id": "VR-READ",
      "name": "Read aloud button",
      "purpose": "Speaker in a small open ring. Ring fills as reading progresses; tap again = pause; long-press = speed.",
      "status": "new"
    },
    {
      "id": "VR-BAR",
      "name": "Read-aloud bar",
      "purpose": "Pinned above the nav while reading: title, ⏮ sentence, ⏯, ⏭ sentence, speed, voice, Stop. Survives scrolling and screen changes within the same object.",
      "status": "new"
    },
    {
      "id": "VR-HIGHLIGHT",
      "name": "Word follow",
      "purpose": "The word being read gets an accent wash; the line scrolls into view. Off-screen → a ‘Back to reading’ pill.",
      "status": "existing (kids read-along) → everywhere"
    },
    {
      "id": "VR-SHEET",
      "name": "Long dictation sheet",
      "purpose": "Bottom sheet for long speech (notes, stories): live partial text, waveform ring, Pause, Done. Text lands as a preview.",
      "status": "new"
    },
    {
      "id": "VR-CMD",
      "name": "Voice commands",
      "purpose": "Per-surface spoken commands (Canvas: add card, connect, read this card; Home: ask; Settings: find). Shown in the ‘What can I say?’ sheet.",
      "status": "new"
    },
    {
      "id": "VR-CONFIRM",
      "name": "Spoken confirmation rule",
      "purpose": "Voice can fill, navigate and approve reversible actions. Irreversible or sensitive actions (send, call, delete, pay, share, new permission, cloud consent) always need a tap.",
      "status": "rule"
    },
    {
      "id": "VR-STATUS",
      "name": "Voice status chip",
      "purpose": "Local speech ready · Speech model missing · Mic permission needed · Cloud voice needs OK · Offline. Shown in the field’s helper line, never as a toast only.",
      "status": "new"
    },
    {
      "id": "VR-SETTINGS",
      "name": "Voice & reading settings",
      "purpose": "Dictation language, auto-punctuation, read speed, voice, follow words, auto-read answers, kids read-along.",
      "status": "existing screens → grouped"
    }
  ],
  "new_lottie": [
    {
      "name": "halo_fx_voice_field",
      "title": "Mic ↔ listening ring",
      "meaning": "The mic glyph opens into a small open ring (open); breathes while recording (listen, loops; level comes from Compose); tightens while recognising (recognize); closes back to the mic (close).",
      "markers": [
        "open",
        "listen",
        "recognize",
        "close"
      ]
    },
    {
      "name": "halo_fx_dictation_insert",
      "title": "Spoken text lands",
      "meaning": "The preview chip shrinks into the caret and the caret blinks once.",
      "markers": [
        "insert"
      ]
    },
    {
      "name": "halo_fx_read_aloud",
      "title": "Read aloud",
      "meaning": "Sound arcs leave the speaker through the ring gap (start), loop gently while reading (reading), fold away (stop).",
      "markers": [
        "start",
        "reading",
        "stop"
      ]
    },
    {
      "name": "halo_fx_voice_wave",
      "title": "Long dictation wave",
      "meaning": "Level bars arranged along the open ring for the dictation sheet; loops while the mic is open.",
      "markers": [
        "listen"
      ]
    },
    {
      "name": "halo_fx_canvas_voice_add",
      "title": "Card from voice",
      "meaning": "A spoken card drops from the ring onto the canvas and a connector draws to its neighbour.",
      "markers": [
        "add"
      ]
    },
    {
      "name": "halo_fx_kids_page_turn",
      "title": "Read-along page turn",
      "meaning": "Story page curls from the upper-right corner (the gap) to the next page.",
      "markers": [
        "turn"
      ]
    },
    {
      "name": "halo_fx_kids_word_pop",
      "title": "Hear it again",
      "meaning": "A tapped word lifts in a soft bubble while it's spoken.",
      "markers": [
        "pop"
      ]
    },
    {
      "name": "halo_fx_listen_chapters",
      "title": "Listen mode progress",
      "meaning": "A segmented open ring fills chapter by chapter; current segment breathes.",
      "markers": [
        "chapter"
      ]
    },
    {
      "name": "halo_fx_explain_back",
      "title": "Explain it back",
      "meaning": "Two speech arcs meet; gaps that weren't covered stay open as small Apricot dots.",
      "markers": [
        "compare"
      ]
    }
  ],
  "screens": [
    {
      "id": "V01",
      "mode": "app",
      "title": "Home: ask by voice, hear every answer",
      "stage": "—",
      "current": "HomeComposer has a mic; answers are not read aloud from the answer itself.",
      "hierarchy": "Answer card with Read aloud (open-ring speaker) · word follow while reading · read-aloud bar · composer: text + mic; long-press mic = long dictation sheet.",
      "entry": [
        "Home",
        "Assistant summon"
      ],
      "exits": [
        {
          "action": "Tap speaker on an answer",
          "event": "tts.request(answerId)",
          "to": "V01 reading"
        },
        {
          "action": "Tap mic",
          "event": "voice.open(composer)",
          "to": "V01 listening"
        },
        {
          "action": "Mic while reading",
          "event": "tts.stop → voice.open (barge-in)",
          "to": "V01 listening"
        }
      ],
      "comps": [
        "VR-FIELD",
        "VR-READ",
        "VR-BAR",
        "VR-HIGHLIGHT",
        "VR-PREVIEW"
      ],
      "states": [
        "idle",
        "listening",
        "preview",
        "reading",
        "paused",
        "speech model missing"
      ],
      "motion": [
        {
          "trigger": "mic tapped AND audio focus granted",
          "animation": "halo_fx_voice_field: open → listen",
          "scope": "mic 48dp",
          "exit": "Stop / blur / app background",
          "fallback": "static ring + 'Listening'",
          "next_action": "—"
        },
        {
          "trigger": "tts playback started (provider event)",
          "animation": "halo_fx_read_aloud: start → reading",
          "scope": "speaker 40dp",
          "exit": "tts.done / stop / barge-in",
          "fallback": "static speaker + progress ring",
          "next_action": "—"
        }
      ],
      "a11y": [
        "Speaker: 'Read answer aloud' ⇄ 'Pause reading'",
        "Reading follows TalkBack: when TalkBack speaks, halo's own reading pauses"
      ],
      "capability": "native (local STT; TTS = selected provider)"
