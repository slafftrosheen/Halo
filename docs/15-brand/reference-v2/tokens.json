  "appearance": "see theme/halo_themes.json and theme/HaloPalette.kt",
  "fx": {
    "_rule": "One light at a time (Aura or Trace); the orb doesn't count. Each effect maps to one state. Uses accent ring colours; Apricot stays 'needs you'. Reduced motion: static glow, no movement.",
    "aura": {
      "use": "presence / hero",
      "shape": "radial",
      "sizeRatio": 2.0,
      "stops": [
        [
          "ringStart",
          0.42
        ],
        [
          "#FF9F6B",
          0.14
        ],
        [
          "transparent",
          0
        ]
      ],
      "blurDp": 6,
      "breathMs": 4000,
      "easing": "breath"
    },
    "trace": {
      "use": "Halo Guide: the one next step",
      "strokeDp": 2.5,
      "gapDeg": 30,
      "gapAtDeg": 45,
      "lapMs": 2400,
      "laps": 1,
      "thenRest": true,
      "glowDp": 22,
      "glowOpacity": 0.4,
      "colors": "accent ring start/end"
    },
    "edgeGlow": {
      "use": "halo acting on the phone (ACTING / ACTING_PHONE only)",
      "insetStrokeDp": 3,
      "glowDp": 26,
      "glowOpacity": 0.45,
      "gapDeg": 20,
      "fadeInMs": 250,
      "fadeOutMs": 150,
      "stopsWhenActingEnds": true
    },
    "shimmer": {
      "use": "thinking / streaming / loading skeletons",
      "sweepMs": 1600,
      "direction": "start→end",
      "highlight": "text → ringStart"
    },
    "bloom": {
      "use": "SUCCESS",
      "rings": 3,
      "durationMs": 600,
      "easing": "ease-out",
      "playOnce": true,
      "haptic": "light",
      "kidsColor": "#FF9F6B"
    },
    "ripple": {
      "use": "listening (mic actually open)",
      "drivenBy": "mic level",
      "rings": 3
    }
  },
  "guide": {
    "meaning": "the user's best next step (accent light)",
    "attention": "Apricot = halo needs you",
    "error": "red = something broke",
    "maxPerScreen": 1,
    "neverOn": [
      "cloud opt-in",
      "purchase",
      "new permission",
      "destructive action"
    ],
    "mustInclude": [
      "why",
      "a way out (Not now / No thanks)"
    ],
    "tipCooldownDays": 7,
    "parts": [
      "next-step card",
      "traced action",
      "step path",
      "halo tip"
    ]
  },
  "wordmark": {
    "text": "halo",
    "font": "Sora 600",
    "tracking": -0.03,
    "o": "Open Ring (gap 45°, upper right)",
    "ringColor": {
