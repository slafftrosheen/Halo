<!-- halo · theme-matched app icons. Paste inside <application>.
     IMPORTANT: move the MAIN/LAUNCHER intent-filter OFF MainActivity onto the "Classic" alias below.
     MainActivity itself must stay enabled (aliases launch it). Exactly ONE alias is enabled at a time;
     HaloAppIconSwitcher toggles them. Deep links / other intent-filters stay on MainActivity. -->
<activity-alias android:name=".icon.Classic" android:targetActivity=".MainActivity" android:exported="true" android:enabled="true"
    android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:label="@string/app_name">
    <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
</activity-alias>
