{
  "schema": "halo-lab-bridge",
  "protocolMajor": 1,
  "protocolMinor": 1,
  "transport": "android-aidl-bounded-json-v1",
  "canonicalOwner": "Halo",
  "clientPackage": "com.slafftrosheen.halomodellab",
  "compatibleLabClientSchemaSha256": "d866967284a236d37c39a720f7c13c46f39b1813f02f560c1857943727bcf231",
  "operations": [
    "handshake",
    "listModels",
    "acquireArtifactLease",
    "renewArtifactLease",
    "releaseArtifactLease",
    "submitCase",
    "queryCase",
    "cancelCase",
    "readEvents",
    "acknowledgeEvents",
    "acquireModel",
    "queryAcquisition",
    "cancelAcquisition",
    "openEvidenceArtifact"
  ],
  "implementedFeatures": [
    "MODEL_INVENTORY",
    "ARTIFACT_LEASES",
    "TEXT_EXECUTION",
    "EVENT_REPLAY",
    "EVIDENCE_ARTIFACT_READ"
  ],
  "textExecution": {
    "workerProcess": ":modelbench",
    "providerId": "provider.litert.local",
    "suiteId": "fast-smoke",
    "suiteVersion": "1",
    "caseId": "short-ready",
    "fixtureId": "fast-smoke-1-short-ready",
    "fixtureManifestSha256": "59e0652c15e4dff7dd7bfebd7cd7c04b478ddf8824995f9a610e13b9c90dfa40",
    "prompt": "Reply with exactly READY.",
    "expectedText": "READY",
    "maximumOutputTokens": 8,
    "backend": "CPU",
    "arbitraryPromptAccepted": false
  },
  "limits": {
    "requestBytes": 32768,
    "replyBytes": 65536,
    "modelsPerPage": 50,
    "eventsPerPage": 64,
    "eventPayloadBytes": 16384,
    "outstandingRunsPerClient": 1,
    "maxPromptCharacters": 512,
    "evidenceArtifactBytes": 2048,
    "concurrentEvidenceArtifactTransfers": 2
  },
  "authentication": {
    "signaturePermission": "com.aistudio.braintool.xkqzps.permission.HALO_LAB_BRIDGE",
    "callerPackage": "com.slafftrosheen.halomodellab",
    "callerUidFromBinder": true,
    "haloConsentRequired": true
  },
  "evidence": {
    "realOrigin": "DEVICE_MEASUREMENT",
    "syntheticOriginNeverAcceptedAsReal": true,
    "unknownFieldsRemainUnknown": true,
    "attemptTerminalWriteOnce": true,
    "replayKey": ["serverEpoch", "remoteRunId", "sequence"],
    "terminalOutputPreview": {
      "maximumCharacters": 512,
      "bytes": "UTF-8 bytes in preview",
      "sha256": "SHA-256 of exact preview bytes",
      "truncation": "explicit boolean; null when unavailable"
    },
    "transferablePayload": {
      "artifactId": "output-<terminal-attempt-uuid>",
      "kind": "complete fixed-smoke text output",
      "maximumBytes": 2048,
      "modelArtifactBytesAllowed": false,
      "requiresTerminalAttemptAndConsent": true
    },
    "terminalMetrics": ["loadMs", "timeToFirstTokenMs", "generationMs", "effectiveBackendCode", "runtimeVersion"]
  }
}
